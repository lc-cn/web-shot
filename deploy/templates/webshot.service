[Unit]
Description=URLSHOT persistent Chrome screenshot API
After=network-online.target webshot-egress.service
Wants=network-online.target
Requires=webshot-egress.service
StartLimitIntervalSec=120
StartLimitBurst=10
[Service]
Type=simple
User=webshot
Group=webshot
WorkingDirectory=/opt/webshot/app
EnvironmentFile=/etc/webshot.env
Environment=PATH=/opt/webshot/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/webshot/node/bin/node /opt/webshot/app/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=70
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/webshot
NoNewPrivileges=true
MemoryHigh=700M
MemoryMax=800M
MemorySwapMax=256M
TasksMax=384
OOMPolicy=kill
LimitNOFILE=16384
[Install]
WantedBy=multi-user.target
