NODE_ENV=production
PORT=3030
DB_PATH=/var/lib/webshot/requests.sqlite
CHROME_PATH=/usr/bin/google-chrome-stable
PUBLIC_HOST=shot.example.com
WARM_PAGES=5
MAX_PAGES=7
# Independent from the five prewarmed pages; pressure temporarily lowers this to two.
MAX_ACTIVE_RENDERS=3
# Opt in only on a VM with usable shared memory; leave 0 for small /dev/shm containers.
CHROME_USE_DEV_SHM=0
# Optional; use the same generated value in the Worker and server.
EDGE_LOG_SECRET=
